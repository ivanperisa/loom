<?xml version="1.0" encoding="utf-8" ?>
<!--
  Logs: files in logs/ (kept 30 days) and the console (journald / docker logs).
  Every line carries the request's trace id, the same id an error response shows the user ("traceId"),
  so a reported error can be found with: grep <traceId> logs/loom-*.log
  Levels come from appsettings.json "Logging" (Information; Microsoft.AspNetCore: Warning).
-->
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      autoReload="true"
      internalLogLevel="Warn"
      internalLogFile="logs/internal-nlog.txt">

  <extensions>
    <add assembly="NLog.Web.AspNetCore"/>
  </extensions>

  <variable name="line"
            value="${longdate}|${level:uppercase=true}|${aspnet-TraceIdentifier:whenEmpty=-}|${logger:shortName=true}|${message}${onexception:inner=${newline}${exception:format=tostring}}|${aspnet-request-method} ${aspnet-request-url:IncludeQueryString=false}" />

  <targets>
    <target xsi:type="File" name="app" fileName="logs/loom-${shortdate}.log" layout="${line}" maxArchiveDays="30" />
    <target xsi:type="File" name="errors" fileName="logs/loom-errors-${shortdate}.log" layout="${line}" maxArchiveDays="90" />
    <target xsi:type="Console" name="console" layout="${line}" />
  </targets>

  <rules>
    <logger name="*" minlevel="Info" writeTo="app,console" />
    <logger name="*" minlevel="Error" writeTo="errors" />
  </rules>
</nlog>
