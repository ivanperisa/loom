# Copy to .env and adjust. All values are optional.

# Match the production PostgreSQL major version (ask for `SELECT version();`).
POSTGRES_VERSION=17

# Host ports
LOOM_DB_PORT=5432
LOOM_API_PORT=5000
LOOM_WEB_PORT=5173
LOOM_ADMINER_PORT=8081

# Set to true on Windows/macOS if hot reload does not pick up file changes.
LOOM_FILE_POLLING=false

# Optional: real Google login next to the dev login (redirect URI http://localhost:5173/signin-oidc).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
